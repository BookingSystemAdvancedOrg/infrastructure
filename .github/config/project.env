# Shared, non-secret configuration for dev.yml / prod.yml / reusable_cicd.yml.
#
# Forking this repo for a new customer? This is the one file to edit for
# everything that's safe to commit. Nothing else in the workflow YAML needs
# to change for a rename.
#
# Loaded into the workflow with: cat .github/config/project.env >> "$GITHUB_ENV"

OIDC_ROLE_ARN_PROD=arn:aws:iam::343695380960:role/prod-infra-oidc-role
OIDC_ROLE_ARN_DEV=arn:aws:iam::877653167825:role/dev-infra-oidc-role
TERRAFORM_STATES_BUCKET_NAME_PROD=prod-test-bucket-sbs
TERRAFORM_STATES_BUCKET_NAME_DEV=dev-test-bucket-sbs
AWS_REGION=eu-north-1
NO_REPLY_EMAIL_ADDRESS=noreply@ithjalparna.se
STRIPE_API_VERSION=2026-07-29.dahlia
GITHUB_ORG=BookingSystemAdvancedOrg@307760488
CUSTOMER_FRONTEND_REPO=customer-front-end
ADMIN_FRONTEND_REPO=admin-front-end
BACKEND_REPO=application

