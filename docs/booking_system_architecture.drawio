        <mxCell id="t2icTqTPWBVXEE8vvvQf-33" connectable="0" parent="t2icTqTPWBVXEE8vvvQf-31" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];" value="&lt;div&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cancelled_charge_failed&lt;/span&gt;&lt;/div&gt;&lt;div&gt;no_show_charge_failed&lt;/div&gt;" vertex="1">
