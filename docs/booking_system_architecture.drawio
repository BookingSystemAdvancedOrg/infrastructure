        <mxCell id="kKfFXhPO5hJ-HZaqVYNp-1" connectable="0" parent="t2icTqTPWBVXEE8vvvQf-31" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="maybe reseved here as well&lt;div&gt;just because of the receipt issue&lt;/div&gt;" vertex="1">
