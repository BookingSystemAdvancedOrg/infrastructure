        <mxCell id="Eohp0Ae3yIvsF_odDcXu-15" connectable="0" parent="Eohp0Ae3yIvsF_odDcXu-14" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Get new Access Token&lt;div&gt;or&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
