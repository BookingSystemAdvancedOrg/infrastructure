" height="38" as="geometry" /></mxCell><mxCell id="cc-upd-72" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="" edge="1" source="cc-upd-65" target="cc-upd-70"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cc-upd-73" connectable="0" parent="cc-upd-72" vertex="1" value="Invoke" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];rotation=-89;"><mxGeometry relative="1" x="0.2" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="cc-upd-74" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value="" edge="1" source="cc-upd-70" target="cc-upd-46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cc-upd-75" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value="" edge="1" source="cc-upd-70" target="cc-upd-48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cc-upd-76" connectable="0" parent="cc-upd-75" vertex="1" value="Read &amp;amp; Delete" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];rotation=4;"><mxGeometry relative="1" x="0.5" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="cc-upd-77" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value="" edge="1" source="cc-upd-70" target="cc-upd-50"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cc-upd-78" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" value="&lt;b&gt;Each run&lt;/b&gt;&lt;br&gt;1. Re-invokes the owning Lambda: &lt;code&gt;CateringLifecycleFn&lt;/code&gt;, &lt;code&gt;NotificationFn&lt;/code&gt;, &lt;code&gt;NoShowCheckFn&lt;/code&gt;, &lt;code&gt;ReactivateMenuItemFn&lt;/code&gt;, &lt;code&gt;ExpireLayoutVersionFn&lt;/code&gt; (allow-list).&lt;br&gt;2. Stream messages: re-reads the record from the Reservation / Order / CateringRequests stream. Older than 23 h &amp;rarr; &lt;code&gt;reconcile&lt;/code&gt; to CateringLifecycleFn, or an alert for notifications.&lt;br&gt;3. Success &amp;rarr; delete. Failure &amp;rarr; stays for next run. After 3 failed replays &amp;rarr; alert once, park 12 h." vertex="1"><mxGeometry x="3300" y="80" width="270" height="230" as="geometry" /></mxCell><mxCell id="cc-upd-79" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" value="" vertex="1"><mxGeometry x="3430" y="420" width="78" height="78" as="geometry" /></mxCell><mxCell id="cc-upd-80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="platform-alerts (SNS)" vertex="1"><mxGeometry x="3369.0" y="384.0" width="200" height="36" as="geometry" /></mxCell><mxCell id="cc-upd-81" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" value="" vertex="1"><