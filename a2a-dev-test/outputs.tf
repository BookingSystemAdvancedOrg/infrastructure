output "contact_flow_id" {
  description = "The A2A test flow (the root moves the test number to it when a2a_dev_test_live)"
  value       = aws_connect_contact_flow.a2a.contact_flow_id
}

output "gateway_url" {
  description = "The wss endpoint Connect calls"
  value       = "wss://${local.hostname}"
}

output "ecr_repository_url" {
  description = "Push the voice gateway image here (tag var.image_tag)"
  value       = aws_ecr_repository.gateway.repository_url
}

output "api_key_secret_arn" {
  description = "The A2A API key (generated by Terraform, write-only; Connect and the gateway read it)"
  value       = aws_secretsmanager_secret.a2a.arn
}

output "agent_arn" {
  description = "The orchestration AI agent"
  value       = aws_cloudformation_stack.connect_ai.outputs["AgentArn"]
}
