# Archive for every catering document that has legal or bookkeeping value:
#
#   offers/<requestId>/v<NNNN>.pdf      - each offer version the owner sent
#                                         (expires after 13 months)
#   signed/<requestId>/v<NNNN>/...      - the signed agreement: the offer PDF,
#                                         each party's signature evidence and
#                                         a manifest of hashes (locked)
#   invoices/<stripeInvoiceId>.pdf      - copy of every finalized Stripe
#                                         invoice/receipt and credit note
#
# Stripe hosts invoices too, but Bokföringslagen makes the restaurant - not
# Stripe - responsible for keeping räkenskapsinformation for 7 years, so a
# copy lands here. The hash of each object is stored on the request record
# (and in catering-request-history), so any later tampering is detectable.
#
# Nothing here is public. Customers and owners download through short-lived
# presigned GET URLs generated by catering-customer / catering-offer.

# S3 bucket names are globally unique across every AWS account, not just
# this one - the account ID suffix guarantees no collision without needing
# a manually-chosen unique name per account.
data "aws_caller_identity" "current" {}

locals {
  is_prod = var.environment == "prod"
}

resource "aws_s3_bucket" "catering_documents" {
  bucket = local.is_prod ? "catering-documents-${data.aws_caller_identity.current.account_id}" : "${var.environment}-catering-documents-${data.aws_caller_identity.current.account_id}"

  # Object Lock is switched on at creation. It can't be switched off again,
  # and versioning (below) can never be suspended once it's on.
  object_lock_enabled = true

  # Dev only: lets the environment be torn down. Dev objects are in
  # GOVERNANCE mode (below), which the destroy can bypass. Prod stays
  # false - and COMPLIANCE-mode objects couldn't be deleted early anyway.
  force_destroy = !local.is_prod

  tags = {
    Environment = var.environment
  }
}

resource "aws_s3_bucket_versioning" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  versioning_configuration {
    status = "Enabled"
  }
}

# No default retention (issue 5, C7): a bucket-wide 7-year COMPLIANCE lock
# would also lock unsigned offer PDFs, which have no legal value and must go
# (GDPR). The writers lock what is evidence, per object, with
# s3:PutObjectRetention:
#
#   signed/, invoices/  prod: COMPLIANCE, 7 years - nobody, not even the
#                       account root user, can delete or overwrite a version
#                       before it expires (Bokföringslagen, contract evidence).
#                       dev: GOVERNANCE, 1 day - same code paths, test data
#                       can still be cleaned up and the bucket destroyed.
#   offers/             no lock; tagged retention=offer and expired after
#                       13 months by the lifecycle rule below.
#
# The mode and days reach the writers as DOCUMENT_LOCK_MODE /
# DOCUMENT_LOCK_DAYS (root config.tf). Object Lock itself stays enabled: it
# can't be switched off once on. Without a rule block this resource removes
# the default retention; objects already written keep their own.
resource "aws_s3_bucket_object_lock_configuration" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  depends_on = [aws_s3_bucket_versioning.catering_documents]
}

resource "aws_s3_bucket_public_access_block" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

# SSE-S3 rather than a customer-managed KMS key: no extra key policy for
# every Lambda role (and presigned URLs) to carry, and Object Lock is what
# protects these documents, not key access.
resource "aws_s3_bucket_server_side_encryption_configuration" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Documents are read a lot in the first weeks (customer downloads, owner
# looks them up) and almost never after a year - Glacier Instant Retrieval
# keeps them millisecond-readable at a fraction of the storage price.
resource "aws_s3_bucket_lifecycle_configuration" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  rule {
    id     = "archive-after-one-year"
    status = "Enabled"

    filter {}

    transition {
      days          = 365
      storage_class = "GLACIER_IR"
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }

    # Delete markers left after the offers below have expired.
    expiration {
      expired_object_delete_marker = true
    }
  }

  # Unsigned offer PDFs (catering-document tags them retention=offer): gone
  # 13 months after they were written. A signed offer is copied to signed/
  # with its lock, so nothing with legal value is lost here.
  rule {
    id     = "expire-offers-after-13-months"
    status = "Enabled"

    filter {
      tag {
        key   = "retention"
        value = "offer"
      }
    }

    expiration {
      days = 396
    }

    noncurrent_version_expiration {
      noncurrent_days = 1
    }
  }

  depends_on = [aws_s3_bucket_versioning.catering_documents]
}

resource "aws_s3_bucket_policy" "catering_documents" {
  bucket = aws_s3_bucket.catering_documents.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "DenyInsecureTransport"
        Effect    = "Deny"
        Principal = "*"
        Action    = "s3:*"
        Resource = [
          aws_s3_bucket.catering_documents.arn,
          "${aws_s3_bucket.catering_documents.arn}/*",
        ]
        Condition = {
          Bool = { "aws:SecureTransport" = "false" }
        }
      }
    ]
  })

  depends_on = [aws_s3_bucket_public_access_block.catering_documents]
}
