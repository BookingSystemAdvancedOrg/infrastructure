%{ if false ~}
The test line's call flow (flow language 2019-10-30).
  1-2  Elin + sv-SE.
  15-17 The greeting from Booqy (the relay, InvokeLambdaFunction): the
       restaurant's guest-facing name from its own data, as SSML; then the
       bot with it (17). Any error or ok != "true": the bot with the fixed
       greeting without a name (3).
  6    The bot returned: next=switch (the agent changed language) goes to 7,
       anything else hangs up (5), as before.
  7-9  Language from $.Lex.SessionAttributes.connectLanguage, voice and engine
       from voice/engine, then the same bot again in that locale; it speaks
       the agent's reply ("say", SSML) in the new voice first. Then back to 6.
  13-14 next=switchEnd (the agent changed language and ended the call in one
       turn): after 7-8, the new voice speaks "say" (14) and the flow hangs up.
  10-12 A failed switch: Elin + sv-SE and the bot again in Swedish; if that
       fails too, the Swedish apology (4) and hang up.
Every bot block also sends turn_attributes (barge-in on, end-of-speech 1200 ms, max 20 s).
  18   Only with flow_logs: Set logging behavior (Enabled), then 1. Without
       it Connect writes no flow logs even when the instance has them on.
Lex session attributes are read in place (never copied into contact
attributes), so the reply text stays out of the contact record.
%{ endif ~}
{
  "Version": "2019-10-30",
  "StartAction": ${jsonencode(flow_logs ? "a1b0c0de-0000-4000-8000-000000000018" : "a1b0c0de-0000-4000-8000-000000000001")},
  "Metadata": {},
  "Actions": [
%{ if flow_logs ~}
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000018",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": { "FlowLoggingBehavior": "Enabled" },
      "Transitions": { "NextAction": "a1b0c0de-0000-4000-8000-000000000001" }
    },
%{ endif ~}
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000001",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": { "TextToSpeechVoice": "Elin", "TextToSpeechEngine": "Neural", "TextToSpeechStyle": "None" },
      "Transitions": { "NextAction": "a1b0c0de-0000-4000-8000-000000000002" }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000002",
      "Type": "UpdateContactData",
      "Parameters": { "LanguageCode": "sv-SE" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000015",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000015", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000015",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": ${jsonencode(relay_arn)},
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": { "dialedNumber": "$.SystemEndpoint.Address" }
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000016",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000003", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000016",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.ok" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000003",
        "Conditions": [
          {
            "NextAction": "a1b0c0de-0000-4000-8000-000000000017",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000003", "ErrorType": "NoMatchingCondition" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000017",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "SSML": "$.External.greeting",
        "LexV2Bot": { "AliasArn": ${jsonencode(alias_arn)} },
        "LexSessionAttributes": {
%{ for k, v in turn_attributes ~}
          ${jsonencode(k)}: ${jsonencode(v)},
%{ endfor ~}
          "callerNumber": "$.CustomerEndpoint.Address",
          "dialedNumber": "$.SystemEndpoint.Address"
        }
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000006",
        "Conditions": [],
        "Errors": [
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000006", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000004", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000003",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": ${jsonencode(greeting)},
        "LexV2Bot": { "AliasArn": ${jsonencode(alias_arn)} },
        "LexSessionAttributes": {
%{ for k, v in turn_attributes ~}
          ${jsonencode(k)}: ${jsonencode(v)},
%{ endfor ~}
          "callerNumber": "$.CustomerEndpoint.Address",
          "dialedNumber": "$.SystemEndpoint.Address"
        }
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000006",
        "Conditions": [],
        "Errors": [
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000006", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000004", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000004",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "Förlåt, något gick fel. Ring gärna igen om en stund." },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000005",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000005", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000005",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000006",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.Lex.SessionAttributes.next" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000005",
        "Conditions": [
          {
            "NextAction": "a1b0c0de-0000-4000-8000-000000000007",
            "Condition": { "Operator": "Equals", "Operands": ["switch"] }
          },
          {
            "NextAction": "a1b0c0de-0000-4000-8000-000000000007",
            "Condition": { "Operator": "Equals", "Operands": ["switchEnd"] }
          }
        ],
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000005", "ErrorType": "NoMatchingCondition" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000007",
      "Type": "UpdateContactData",
      "Parameters": { "LanguageCode": "$.Lex.SessionAttributes.connectLanguage", "TargetContact": "Current" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000008",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000010", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000008",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "$.Lex.SessionAttributes.voice",
        "TextToSpeechEngine": "$.Lex.SessionAttributes.engine"
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000013",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000010", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000009",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "SSML": "$.Lex.SessionAttributes.say",
        "LexV2Bot": { "AliasArn": ${jsonencode(alias_arn)} },
        "LexSessionAttributes": {
%{ for k, v in turn_attributes ~}
          ${jsonencode(k)}: ${jsonencode(v)},
%{ endfor ~}
          "callerNumber": "$.Lex.SessionAttributes.callerNumber",
          "dialedNumber": "$.Lex.SessionAttributes.dialedNumber",
          "tenantId": "$.Lex.SessionAttributes.tenantId",
          "callId": "$.Lex.SessionAttributes.callId",
          "lang": "$.Lex.SessionAttributes.lang"
        }
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000006",
        "Conditions": [],
        "Errors": [
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000006", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000010", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000010",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": { "TextToSpeechVoice": "Elin", "TextToSpeechEngine": "Neural", "TextToSpeechStyle": "None" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000011",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000004", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000011",
      "Type": "UpdateContactData",
      "Parameters": { "LanguageCode": "sv-SE", "TargetContact": "Current" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000012",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000004", "ErrorType": "NoMatchingError" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000012",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": ${jsonencode(resume_sv)},
        "LexV2Bot": { "AliasArn": ${jsonencode(alias_arn)} },
        "LexSessionAttributes": {
%{ for k, v in turn_attributes ~}
          ${jsonencode(k)}: ${jsonencode(v)},
%{ endfor ~}
          "callerNumber": "$.CustomerEndpoint.Address",
          "dialedNumber": "$.SystemEndpoint.Address",
          "tenantId": "$.Lex.SessionAttributes.tenantId",
          "callId": "$.Lex.SessionAttributes.callId",
          "lang": "sv"
        }
      },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000006",
        "Conditions": [],
        "Errors": [
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000006", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "a1b0c0de-0000-4000-8000-000000000004", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000013",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.Lex.SessionAttributes.next" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000009",
        "Conditions": [
          {
            "NextAction": "a1b0c0de-0000-4000-8000-000000000014",
            "Condition": { "Operator": "Equals", "Operands": ["switchEnd"] }
          }
        ],
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000009", "ErrorType": "NoMatchingCondition" }]
      }
    },
    {
      "Identifier": "a1b0c0de-0000-4000-8000-000000000014",
      "Type": "MessageParticipant",
      "Parameters": { "SSML": "$.Lex.SessionAttributes.say" },
      "Transitions": {
        "NextAction": "a1b0c0de-0000-4000-8000-000000000005",
        "Errors": [{ "NextAction": "a1b0c0de-0000-4000-8000-000000000005", "ErrorType": "NoMatchingError" }]
      }
    }
  ]
}
