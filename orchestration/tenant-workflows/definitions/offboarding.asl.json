{
  "Comment": "Tenant offboarding. Started by platform-tenants (POST /platform/tenants/{tenantId}/offboard). Blocks the tenant immediately (status offboarding - every Lambda's tenant check then refuses it), disables and signs out all of its users, detaches all of its domains, marks it offboarded and archives its website repo (removing this environment's deploy role) with purgeAt = now + ${retention_days} days. Data is NOT deleted here: the tenant-purge Lambda deletes it once purgeAt has passed (docs/TENANT-ONBOARDING.md, Offboarding). Catering documents (7-year Object Lock) and the restaurant's Stripe account are kept.",
  "QueryLanguage": "JSONata",
  "TimeoutSeconds": 21600,
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Assign": {
        "tenantId": "{% $states.input.tenantId %}",
        "requestedBy": "{% $exists($states.input.requestedBy) ? $states.input.requestedBy : 'unknown' %}",
        "users": [],
        "domains": [],
        "detachFailures": [],
        "failure": {},
        "failedState": "{% '' %}",
        "websiteFailure": "{% '' %}",
        "purgeAt": "{% $fromMillis($toMillis($now()) + ${retention_days} * 86400000, '[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]Z') %}"
      },
      "Next": "MarkOffboarding"
    },
    "MarkOffboarding": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${tenant_table}",
        "Key": {
          "PK": { "S": "{% 'TENANT#' & $tenantId %}" },
          "SK": { "S": "PROFILE" }
        },
        "UpdateExpression": "SET #status = :status, offboardingRequestedBy = :by, offboardingStartedAt = :now, updatedAt = :now",
        "ConditionExpression": "attribute_exists(PK)",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "offboarding" },
          ":by": { "S": "{% $requestedBy %}" },
          ":now": { "S": "{% $now() %}" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "ListUsers"
    },
    "ListUsers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Arguments": {
        "TableName": "${user_table}",
        "IndexName": "${user_tenant_index}",
        "KeyConditionExpression": "tenantId = :t",
        "ProjectionExpression": "email, cognitoSub",
        "ExpressionAttributeValues": {
          ":t": { "S": "{% $tenantId %}" }
        }
      },
      "Assign": {
        "users": "{% $states.result.Items %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "DisableUsers"
    },
    "DisableUsers": {
      "Type": "Map",
      "Items": "{% $users %}",
      "MaxConcurrency": 5,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "DisableUser",
        "States": {
          "DisableUser": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:cognitoidentityprovider:adminDisableUser",
            "Arguments": {
              "UserPoolId": "${user_pool_id}",
              "Username": "{% $states.input.email.S %}"
            },
            "Retry": [
              {
                "ErrorEquals": ["CognitoIdentityProvider.TooManyRequestsException", "CognitoIdentityProvider.InternalErrorException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 5,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["CognitoIdentityProvider.UserNotFoundException"],
                "Next": "UserGone"
              }
            ],
            "Output": "{% $states.input %}",
            "Next": "SignOutUser"
          },
          "SignOutUser": {
            "Type": "Task",
            "Comment": "Revokes refresh tokens; access tokens already issued expire within the hour and are refused meanwhile by the tenant status check.",
            "Resource": "arn:aws:states:::aws-sdk:cognitoidentityprovider:adminUserGlobalSignOut",
            "Arguments": {
              "UserPoolId": "${user_pool_id}",
              "Username": "{% $states.input.email.S %}"
            },
            "Retry": [
              {
                "ErrorEquals": ["CognitoIdentityProvider.TooManyRequestsException", "CognitoIdentityProvider.InternalErrorException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 5,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["CognitoIdentityProvider.UserNotFoundException"],
                "Next": "UserGone"
              }
            ],
            "End": true
          },
          "UserGone": {
            "Type": "Succeed"
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "ListDomains"
    },
    "ListDomains": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
      "Arguments": {
        "TableName": "${tenant_table}",
        "KeyConditionExpression": "PK = :pk AND begins_with(SK, :prefix)",
        "ExpressionAttributeValues": {
          ":pk": { "S": "{% 'TENANT#' & $tenantId %}" },
          ":prefix": { "S": "DOMAIN#" }
        }
      },
      "Assign": {
        "domains": "{% $states.result.Items %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "DetachDomains"
    },
    "DetachDomains": {
      "Type": "Map",
      "Comment": "Runs the domain-detach workflow for each domain (platform subdomain and custom domains alike) and waits for it. A failed detach is reported but doesn't stop offboarding - the tenant is already blocked.",
      "Items": "{% $domains %}",
      "MaxConcurrency": 2,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "DetachDomain",
        "States": {
          "DetachDomain": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Arguments": {
              "StateMachineArn": "${domain_detach_state_machine_arn}",
              "Input": {
                "tenantId": "{% $tenantId %}",
                "domain": "{% $substringAfter($states.input.SK.S, 'DOMAIN#') %}"
              }
            },
            "Output": {
              "domain": "{% $substringAfter($states.input.SK.S, 'DOMAIN#') %}",
              "ok": true
            },
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Output": {
                  "domain": "{% $substringAfter($states.input.SK.S, 'DOMAIN#') %}",
                  "ok": false,
                  "error": "{% $string($states.errorOutput.Error) %}"
                },
                "Next": "DetachFailed"
              }
            ],
            "End": true
          },
          "DetachFailed": {
            "Type": "Pass",
            "End": true
          }
        }
      },
      "Assign": {
        "detachFailures": "{% $append([], $states.result[ok = false].domain) %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "MarkOffboarded"
    },
    "MarkOffboarded": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${tenant_table}",
        "Key": {
          "PK": { "S": "{% 'TENANT#' & $tenantId %}" },
          "SK": { "S": "PROFILE" }
        },
        "UpdateExpression": "SET #status = :status, offboardedAt = :now, updatedAt = :now, purgeAt = :purgeAt",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "offboarded" },
          ":now": { "S": "{% $now() %}" },
          ":purgeAt": { "S": "{% $purgeAt %}" }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}", "failedState": "{% $states.context.State.Name %}" },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "SiteReposEnabled"
    },
    "SiteReposEnabled": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% ${site_repos_enabled} %}",
          "Next": "ArchiveWebsite"
        }
      ],
      "Default": "NotifyOffboarded"
    },
    "ArchiveWebsite": {
      "Type": "Task",
      "Comment": "site-repo removes this environment's deploy role and repo variables, and archives site-<slug> once no other environment uses it. Never deletes the repo. A failure is reported in the closing alert and doesn't stop offboarding.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${site_repo_function_arn}",
        "Payload": {
          "action": "archive",
          "tenantId": "{% $tenantId %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "websiteFailure": "{% ' Website repo NOT archived (' & $string($states.errorOutput.Error) & ') - press Archive on the Website tab.' %}" },
          "Next": "NotifyOffboarded"
        }
      ],
      "Next": "NotifyOffboarded"
    },
    "NotifyOffboarded": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${alert_topic_arn}",
        "Subject": "${environment}: tenant offboarded",
        "Message": "{% 'Tenant ' & $tenantId & ' is offboarded: ' & $string($count($users)) & ' user(s) disabled, ' & $string($count($domains)) & ' domain(s) detached' & ($count($detachFailures) > 0 ? ' (FAILED: ' & $join($detachFailures, ', ') & ' - start domain-detach for these manually)' : '') & '.' & $websiteFailure & '\\n\\nIts data is deleted automatically on ' & $substring($purgeAt, 0, 10) & ' (Booqy Console shows the date). Export it before then if the customer asked for it. Kept: catering documents and the Stripe account of the restaurant.' %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Offboarded"
        }
      ],
      "Next": "Offboarded"
    },
    "Offboarded": {
      "Type": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${alert_topic_arn}",
        "Subject": "${environment}: tenant offboarding failed",
        "Message": "{% 'Offboarding tenant ' & $tenantId & ' failed at ' & $failedState & '.\\n\\n' & $string($failure) & '\\n\\nThe tenant is blocked (status offboarding) - fix the cause and start offboarding again. Execution: ' & $states.context.Execution.Id %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "OffboardingFailed"
        }
      ],
      "Next": "OffboardingFailed"
    },
    "OffboardingFailed": {
      "Type": "Fail",
      "Error": "OffboardingFailed",
      "Cause": "See the alert email."
    }
  }
}
